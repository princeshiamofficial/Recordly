{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CamVerse",
  "version": "1.3.5",
  "identifier": "app.camverse.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CamVerse — Screen Recorder & Studio Demo Creator",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 CamVerse Technologies. All rights reserved.",
    "publisher": "CamVerse Technologies",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128@2x.png",
        "displayLanguageSelector": false
      }
    }
  }
}
